# Grafana Cloud OTLP push credentials — copy to .env.grafana (gitignored) and fill in.
#
# Get these from your Grafana Cloud stack: Connections -> Add new connection ->
# OpenTelemetry -> Minimal setup. That page shows the endpoint and a way to
# generate a scoped push token.
#
# GRAFANA_OTLP_INSTANCE_ID is the OTLP *instance* ID shown on that page — it is
# NOT the same as the org id you can decode out of a glc_ token payload. Using
# the wrong one gets a 401 that looks like a bad token when it's actually a bad
# username.
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
